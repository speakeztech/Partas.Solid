import { Store, useStore } from "@tanstack/solid-store";
import { int32ToString } from "fable-library/Util.js";

export const store = new Store(0);

export function Component() {
    const count = useStore(store, (state) => state);
    return <div onClick={(_arg) => {
        store.setState((s) => s + 1);
    }}>
        {int32ToString(count())}
    </div>;
}
